<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.breakout.holdings</string>
  <!-- 보유 종목 새 소식 (2026-10-17) — 매일 22:00, 미국 장 열리기 전에 trading-journal 보유 종목의 새 뉴스·8-K·증권사 리포트를 텔레그램으로.
       아침 07:10 은 morning.sh 맨 앞에서 같은 스크립트가 돈다. 새 것이 없으면 아무것도 보내지 않는다.
       PATH 에 claude 위치(/usr/local/bin · /opt/homebrew/bin)가 있어야 한 줄 요약이 된다 — 없으면 제목만 보낸다. -->
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string><string>__REPO__/scripts/holdings-watch.js</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__LOGS__/holdings.log</string>
  <key>StandardErrorPath</key><string>__LOGS__/holdings.err.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
</dict>
</plist>
