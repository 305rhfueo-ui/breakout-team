<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.breakout.daily</string>
  <!-- 아침 작업(morning.sh): RS 사이트 갱신 대기 → 스캔·6팀 관심 목록·push → 화~토 start breakout.
       07:10 에 시작하지만 RS 사이트가 실제로 갱신되는 09:30~10:50 KST 까지 기다린다 (cron 06:50 은 GitHub 이 매일 늦게 돌린다). -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string><string>-s</string>
    <string>/bin/bash</string><string>__REPO__/deploy/macmini/morning.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>10</integer></dict>
  <key>StandardOutPath</key><string>__LOGS__/daily.log</string>
  <key>StandardErrorPath</key><string>__LOGS__/daily.err.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
</dict>
</plist>
