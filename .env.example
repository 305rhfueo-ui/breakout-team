# RS 데이터 (기본값이 있으므로 보통 건드릴 필요 없음)
RS_DATA_URL=https://305rhfueo-ui.github.io/RS_Investment/static/result.json

# SEC EDGAR — UA 필수. '앱명/버전 (연락이메일)' 형식만 통과한다.
# URL 이 섞이면 403 이 나온다.
SEC_USER_AGENT=breakout-team/0.1 (your-email@example.com)

# 캐시 위치. 비워두면 OS별 기본값 (Windows: %LOCALAPPDATA%\breakout-team)
# ⚠️ OneDrive 폴더 안으로 지정하지 말 것 — 매일 대용량 동기화가 발생한다
# CACHE_DIR=

# 리서치 상한 (LLM 비용 통제)
POPUP_CAP=20      # 팝업 상세(실적·뉴스·국내리포트) 수집 종목 수
EP_CAP=40         # 4팀 Congestion 분석 종목 수

# 텔레그램 보고 (선택)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# 노트북LM 건너뛰기 (무인 실행 시 권장)
# SKIP_NOTEBOOKLM=1
